[Desktop Entry]
Type=Application
Name=Display 4K 60Hz Setup
Comment=Apply 4K@60Hz CVT-RB mode on DP-1
Exec=sh -c 'xrandr --newmode "3840x2160_rb" 533.00 3840 3888 3920 4000 2160 2163 2168 2222 +hsync -vsync 2>/dev/null; xrandr --addmode DP-1 "3840x2160_rb" 2>/dev/null; xrandr --output DP-1 --mode "3840x2160_rb" 2>/dev/null'
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
StartupNotify=false
Terminal=false
